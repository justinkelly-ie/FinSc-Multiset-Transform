          Stage1.UniverseStaging,
          Stage1.Goh,
          Stage1.MaxelTransform,
          Stage1.ScaleCategory,
          Stage1.ScaleHierarchy,
          Stage1.ScalePipeline,
          Stage1.Multiset.Dynamics,
          Stage1.Multiset.StreamTransducer,
          Stage1.Multiset.QuadStreamPipeline,
          Stage1.Math.Infinitesimal,
          Stage1.Math.LawAlgebra,
          Stage1.Math.OnSeq.ConjugateAdjunction,
          Stage1.Math.OnSeq.ConjugateDuality,
          Stage1.Math.OnSeq.SpreadStream,
          Stage1.Math.Transform.Reflect.Goh,
          Stage1.Math.Transform.MultisetFilter,
          Stage1.Math.Transform.ChromogeometryMetric,
          Stage1.Math.Transform.QuadStreamAdjunction,
